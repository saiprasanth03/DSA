Given an array nums of length n, return an array answer of length n - 1 such that answer[i] = nums[i] | nums[i + 1] where | is the bitwise OR operation

Example 1:
Input: nums = [1,3,7,15]
Output: [3,7,15]
Example 2:
Input: nums = [8,4,2]
Output: [12,6]

Constraints:
2 <= nums.length <= 100
0 <= nums[i] <= 100

//code
class Solution {
    public List<Integer> orArray(List<Integer> A) {
        // User code goes here
        List<Integer> ans = new ArrayList<>();
        for(int i=1;i<A.size();i++){
            ans.add(A.get(i-1)|A.get(i));
        }
        return ans;
    }
}
