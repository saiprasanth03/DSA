You are given a string s. Return the array of unique characters, sorted by highest to lowest occurring characters.
If two or more characters have same frequency then arrange them in alphabetic order.
Example 1
Input : s = "tree"
Output : ['e', 'r', 't' ]
Explanation :
The occurrences of each character are as shown below :
e --> 2
r --> 1
t --> 1.
The r and t have same occurrences , so we arrange them by alphabetic order.
Example 2
Input : s = "raaaajj"
Output : ['a' , 'j', 'r' ]
Explanation :
The occurrences of each character are as shown below :
a --> 4
j --> 2
r --> 1

Constraints:-
1 <= s.length <= 10^5
s consist of only lowercase English characters.

//code
import java.util.*;
class Solution {    
    public List<Character> frequencySort(String s) {
        int a[] = new int[26];
        int found = 0;
        // Count frequency
        for(int i = 0; i < s.length(); i++){
            char c = s.charAt(i);
            if(a[c - 'a'] == 0){
                found++;
            }
            a[c - 'a']++;
        }
        List<Character> result = new ArrayList<>();
        while(found != 0){
            int maxIndex = -1;
            // Find index of max frequency
            for(int i = 0; i < 26; i++){
                if(a[i] > 0 && (maxIndex == -1 || a[i] > a[maxIndex])){
                    maxIndex = i;
                }
            }
            result.add((char)(maxIndex + 'a'));   
            a[maxIndex] = 0;  // reset after using
            found--;
        }
        return result;
    }
}
